# ── Required ──────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA-replace-me

# Your numeric Telegram user ID (get from @userinfobot)
# The bot will ignore messages from anyone else.
ALLOWED_USER_ID=123456789

# Buffer access token: publish.buffer.com/settings/api → API (Beta) → Create Token
BUFFER_ACCESS_TOKEN=1/replace-me

# ── Recommended ───────────────────────────────────────────────────────────────

# imgbb API key (free): https://api.imgbb.com/
# Primary image host. Buffer requires public image URLs — without imgbb the bot
# falls back to catbox.moe and 0x0.st, which are flakier.
IMGBB_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Binance Square OpenAPI key — enables crypto-content publishing to Binance Square.
# Get from: Binance Skills Hub → square-post → Creator Center.
# The bot uses the official media flow from binance/binance-skills-hub:
# image posts up to 4 photos (contentType=1), articles with cover (contentType=2, SDK layer),
# and since v3.0 — video posts (contentType=3, forwarded video ≤ 20 MB).
BINANCE_SQUARE_API_KEY=

# Whether to upload media (photos/video) to Binance Square (1 = default, 0 = text-only posts).
# Useful to disable temporarily if you're hitting the 400 uploads/day quota.
BINANCE_USE_IMAGES=1

# If a media upload fails: 0 (default) = keep the post queued and retry WITH media;
# 1 = legacy behaviour, publish text-only immediately (media is lost).
BINANCE_IMAGE_FALLBACK_TEXT=0

# Retry policy: attempts before a post is moved to dead-letter, and backoff bounds.
BINANCE_MAX_ATTEMPTS=6
BINANCE_BACKOFF_BASE_SEC=300
BINANCE_BACKOFF_MAX_SEC=21600

# Clean published posts from binance_queue after N days (0 = keep forever).
BINANCE_PUBLISHED_TTL_DAYS=30

# Show the "🚀 More tools" ecosystem section in the main menu (1 = default, 0 = hide).
ECOSYSTEM_LINKS_ENABLED=1

# Optional announcement banner shown at the top of /start (e.g. migration notice).
SUNSET_NOTICE=

# Scheduling window in hours. Each forwarded post gets a random dueAt in this range.
# Defaults: 1h min, 240h (10 days) max.
SCHEDULE_MIN_HOURS=1
SCHEDULE_MAX_HOURS=240

# How many rows to keep in the post_history journal. Rotates oldest first.
HISTORY_LIMIT=500

# SQLite path. Default: /app/data/bot.db (Docker / Railway volume).
# For local dev: ./bot.db
DB_PATH=/app/data/bot.db
